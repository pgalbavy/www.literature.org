{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "ts",
    "outDir": "hugo/static/js",
    "strict": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["ts/**/*.ts", "ts/**/*.d.ts"]
}
