{{- /* contents.json for the site root, /authors/, each author and each book,
     in the shape the legacy contents.json files had, so client-side code
     (include.ts, epub.ts, and anything new) can fetch it from the same URL.
     Built from the front matter (`params:` holds the metadata merged from
     the old files) and the page tree, which is now the only source of the
     author, book and chapter lists. */ -}}
{{- $parts := split (trim .RelPermalink "/") "/" -}}
{{- $c := dict "title" .Title -}}
{{- if .IsHome -}}
  {{- $c = dict "title" "" -}}
  {{- $items := slice -}}
  {{- range .Sections.ByWeight -}}
    {{- $items = $items | append (dict "href" (path.Base (trim .RelPermalink "/")) "title" .Title) -}}
  {{- end -}}
  {{- $c = merge $c (dict "chapters" $items) -}}
{{- else if eq .RelPermalink "/authors/" -}}
  {{- $items := slice -}}
  {{- range .Sections.ByTitle -}}
    {{- $items = $items | append (dict "href" (path.Base (trim .RelPermalink "/")) "name" .Title) -}}
  {{- end -}}
  {{- $c = merge $c (dict "authors" $items) -}}
{{- else if eq (len $parts) 2 -}}
  {{- $items := slice -}}
  {{- range .Sections.ByWeight -}}
    {{- $book := dict "href" (path.Base (trim .RelPermalink "/")) "title" .Title -}}
    {{- with .Params.year }}{{ $book = merge $book (dict "year" .) }}{{ end -}}
    {{- $items = $items | append $book -}}
  {{- end -}}
  {{- $c = merge $c (dict "books" $items) -}}
{{- else -}}
  {{- $items := slice -}}
  {{- range .RegularPages.ByWeight -}}
    {{- $items = $items | append (dict "href" (path.Base .RelPermalink) "title" .Title) -}}
  {{- end -}}
  {{- $c = merge $c (dict "chapters" $items) -}}
  {{- with .Params.book_author }}{{ $c = merge $c (dict "author" .) }}{{ end -}}
  {{- with .Params.source }}{{ $c = merge $c (dict "source" .) }}{{ end -}}
{{- end -}}
{{- with .Params.pen_names }}{{ $c = merge $c (dict "aliases" .) }}{{ end -}}
{{- range $key := slice "year" "lastupdated" "cmdline" "links" -}}
  {{- with index $.Params $key }}{{ $c = merge $c (dict $key .) }}{{ end -}}
{{- end -}}
{{- $c | jsonify (dict "indent" "\t") -}}
